<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wechat.sync</groupId>
    <artifactId>wechat-sync-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>wechat-sync-server</name>
    <description>WeChat sync server (framework4j + MyBatis Plus + PostgreSQL)</description>

    <properties>
        <java.version>17</java.version>
        <!-- JitPack 的 com.github.funcommons.framework4j:v1.9.0 无对应上游 tag（JitPack status=none），
             故走源码本地 install，groupId 为 fun.commons、版本 1.10.0（详见 PROGRESS.md） -->
        <framework4j.version>1.10.0</framework4j.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <repositories>
        <!-- 当前 framework4j 走本地 install（fun.commons），此仓库保留以便上游发布可用 tag 后切回 JitPack -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- framework4j 全家桶（api/web/datetime/id/accesstoken/idempotency/rate-limit/redis/sql-tracing ...） -->
        <dependency>
            <groupId>fun.commons</groupId>
            <artifactId>framework4j-all</artifactId>
            <version>${framework4j.version}</version>
        </dependency>

        <!-- MyBatis Plus（Spring Boot 3） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9 起 jsqlparser 拆分，分页插件需单独引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- 驱动（版本由 Spring Boot parent 管理） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok（T2 追加：实体/服务样板代码；framework4j 自带为 provided，不传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试（版本由 Spring Boot parent 管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 测试 JVM 关闭后台调度拨轮：@SpringBootTest 会拉起完整应用，存活的调度线程
                             （200ms 的 dispatcher、30s/60s 的回收与物化）会抢认领测试造的「PENDING + 到期」行，
                             造成只在全量套件出现的随机失败。只进测试 JVM，生产配置不受影响。 -->
                        <wx-sync.scheduling.enabled>false</wx-sync.scheduling.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
